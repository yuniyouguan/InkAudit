<?xml version="1.0" encoding="utf-8"?>
<!-- 墨鉴（InkAudit）主工作台：纯色微明度层次（Surface 0~3），左审校正文流 + 右全文诊断与热力导航 -->
<Window
    x:Class="InkAudit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InkAudit"
    xmlns:models="using:InkAudit.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="墨鉴">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource Surface0Brush}"
          ActualThemeChanged="OnRootActualThemeChanged">

        <!-- 响应式窗口断点：根据窗口宽度自动调整右侧诊断栏宽度与留白 -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowSizeStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1040" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="316" />
                        <Setter Target="WorkspaceGrid.Padding" Value="20,8,20,20" />
                        <Setter Target="WorkspaceGrid.ColumnSpacing" Value="16" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="272" />
                        <Setter Target="WorkspaceGrid.Padding" Value="12,8,12,12" />
                        <Setter Target="WorkspaceGrid.ColumnSpacing" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 第 0 行：极简自定义窗口标题栏（应用名 + 动态章节字数统计） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="20,0,148,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind Strings.AppTitle}"
                    FontSize="14"
                    FontWeight="{x:Bind TypeScale.StrongWeight, Mode=OneWay}"
                    Foreground="{ThemeResource InkPrimaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="ChapterStatsText"
                    Text=""
                    FontSize="12"
                    FontWeight="{x:Bind TypeScale.BodyWeight, Mode=OneWay}"
                    Typography.NumeralAlignment="Tabular"
                    Foreground="{ThemeResource MutedTextBrush}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- 第 1 行：核心操作工具栏（左侧文本操作，右侧主检测 CTA 与设置入口） -->
        <Grid Grid.Row="1" Padding="20,4,20,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：粘贴、导入、整章编辑、复制、清空 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Click="OnPasteOverwriteClick" Style="{StaticResource GhostSurfaceButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE77F;" FontSize="12.5" Foreground="{ThemeResource InkSecondaryBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                        <TextBlock Text="{x:Bind Strings.ActionPaste}" FontWeight="{x:Bind TypeScale.MediumWeight, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="OnImportFileClick" Style="{StaticResource GhostSurfaceButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="12.5" Foreground="{ThemeResource InkSecondaryBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                        <TextBlock Text="{x:Bind Strings.ActionImport}" FontWeight="{x:Bind TypeScale.MediumWeight, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="BulkEditButton" Click="OnOpenBulkEditorClick" Style="{StaticResource GhostSurfaceButtonStyle}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="12.5" Foreground="{ThemeResource InkSecondaryBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                        <TextBlock Text="{x:Bind Strings.ActionEdit}" FontWeight="{x:Bind TypeScale.MediumWeight, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="CopyAllButton" Click="OnCopyAllClick" Style="{StaticResource GhostSurfaceButtonStyle}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            x:Name="CopyAllIcon"
                            Glyph="&#xE8C8;"
                            FontSize="12.5"
                            Foreground="{ThemeResource InkSecondaryBrush}"
                            VerticalAlignment="Center"
                            Margin="0,1,0,0"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <ScaleTransform x:Name="CopyCheckScale" ScaleX="1" ScaleY="1" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                        <TextBlock x:Name="CopyAllLabel" Text="{x:Bind Strings.ActionCopy}" FontWeight="{x:Bind TypeScale.MediumWeight, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="ClearAllButton" Click="OnClearAllClick" Style="{StaticResource GhostSurfaceButtonStyle}" Padding="8,6" IsEnabled="False">
                    <FontIcon Glyph="&#xE74D;" FontSize="12.5" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                </Button>
            </StackPanel>

            <!-- 右侧：执行进度、弹性轻提示、主检测按钮与设置按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- 检测进行中的加载环与取消按钮 -->
                <StackPanel
                    x:Name="BusyStatusPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <ProgressRing x:Name="BusyRing" Width="15" Height="15" IsActive="False" />
                    <Button Content="{x:Bind Strings.ActionCancel}" Style="{StaticResource GhostSurfaceButtonStyle}" Padding="8,4" FontSize="12" Click="OnCancelAuditClick" />
                </StackPanel>

                <!-- 欠阻尼弹性完成提示胶囊（2.5 秒后自动淡出消失） -->
                <Border
                    x:Name="ActionToastPill"
                    Background="{ThemeResource Surface2Brush}"
                    CornerRadius="8"
                    Padding="10,5"
                    Opacity="0"
                    Visibility="Collapsed"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ToastScaleTransform" ScaleX="0.8" ScaleY="0.8" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource HumanAccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                        <TextBlock x:Name="ActionToastText" Text="" FontSize="12" FontWeight="{x:Bind TypeScale.MediumWeight, Mode=OneWay}" Foreground="{ThemeResource InkPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 主操作组：开始检测 + 更多检测方式下拉 -->
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button
                        x:Name="PrimaryAuditButton"
                        Style="{StaticResource MinimalPrimaryButtonStyle}"
                        CornerRadius="8,2,2,8"
                        Click="OnStartAuditClick">
                        <TextBlock Text="{x:Bind Strings.ActionStartAudit}" FontWeight="{x:Bind TypeScale.MediumWeight, Mode=OneWay}" />
                    </Button>

                    <Button
                        x:Name="AuditMoreButton"
                        Style="{StaticResource MinimalPrimaryButtonStyle}"
                        CornerRadius="2,8,8,2"
                        Padding="8,7">
                        <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource PrimaryCtaFgBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="{x:Bind Strings.ActionMergedOnly}" Click="OnRunMergedOnlyClick" />
                                <MenuFlyoutItem Text="{x:Bind Strings.ActionRecheckModified}" Click="OnRecheckModifiedClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- 设置弹窗入口 -->
                <Button
                    x:Name="SettingsButton"
                    Style="{StaticResource GhostSurfaceButtonStyle}"
                    Click="OnOpenSettingsClick"
                    Padding="8,6">
                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource InkSecondaryBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 第 2 行：必要校验与错误提示条（正常态隐藏） -->
        <InfoBar
            x:Name="MainInfoBar"
            Grid.Row="2"
            IsOpen="False"
            IsClosable="True"
            Margin="20,0,20,8" />

        <!-- 第 3 行：双栏主工作区（左：一体化正文与审校流，右：全文诊断与段落分布） -->
        <Grid x:Name="WorkspaceGrid" Grid.Row="3" Padding="20,8,20,20" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SidebarColumn" Width="316" />
            </Grid.ColumnDefinitions>

            <!-- 左侧主容器（Surface 1，支持直接拖入 .txt / .md 文件） -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource Surface1Brush}"
                BorderThickness="0"
                CornerRadius="12"
                AllowDrop="True"
                DragOver="OnEditorDragOver"
                Drop="OnEditorDrop">
                <Grid>
                    <!-- 视图 A：空态纯输入区 -->
                    <Grid
                        x:Name="EmptyCanvasPanel"
                        Padding="20"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox
                            x:Name="WelcomePasteBox"
                            Grid.Row="0"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FontSize="15"
                            FontWeight="{x:Bind TypeScale.BodyWeight, Mode=OneWay}"
                            Padding="16,14"
                            CornerRadius="10"
                            Background="{ThemeResource Surface2Brush}"
                            PlaceholderText="{x:Bind Strings.PlaceholderPaste}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextChanged="OnWelcomePasteBoxTextChanged" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button
                                x:Name="WelcomeStartButton"
                                Content="{x:Bind Strings.ActionStartAudit}"
                                Style="{StaticResource MinimalPrimaryButtonStyle}"
                                Click="OnCommitWelcomeAndAuditClick"
                                Visibility="Collapsed" />
                            <Button
                                Content="{x:Bind Strings.ActionPasteAndAudit}"
                                Style="{StaticResource GhostSurfaceButtonStyle}"
                                Background="{ThemeResource Surface2Brush}"
                                Padding="12,7"
                                Click="OnPasteAndAuditClick" />
                        </StackPanel>
                    </Grid>

                    <!-- 视图 B：一体化段落审校流（单击聚焦展开操作，双击原地改写） -->
                    <Grid x:Name="ManuscriptSheetContainer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 当前激活筛选提示条（仅在用户点击右侧占比筛选时显示） -->
                        <Border
                            x:Name="ActiveFilterBanner"
                            Grid.Row="0"
                            Background="{ThemeResource Surface3Brush}"
                            CornerRadius="8"
                            Margin="16,12,16,0"
                            Padding="12,6"
                            Visibility="Collapsed">
                            <Grid>
                                <TextBlock
                                    x:Name="ActiveFilterLabel"
                                    Text=""
                                    FontSize="12"
                                    FontWeight="{x:Bind TypeScale.MediumWeight, Mode=OneWay}"
                                    Typography.NumeralAlignment="Tabular"
                                    Foreground="{ThemeResource InkPrimaryBrush}"
                                    VerticalAlignment="Center" />
                                <Button
                                    Content="{x:Bind Strings.ActionClearFilter}"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="OnResetFilterClick" />
                            </Grid>
                        </Border>

                        <!-- 虚拟化段落列表（基于 WinUI 3 ItemsRepeater） -->
                        <ScrollViewer
                            x:Name="ManuscriptScrollViewer"
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            Padding="16,14,16,24">
                            <ItemsRepeater x:Name="ParagraphRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ParagraphItem">
                                        <!-- 单段落行容器：左侧编号色带 + 中央正文/编辑 + 右侧指标边注 -->
                                        <Border
                                            Background="{x:Bind RowBackground, Mode=OneWay}"
                                            BorderThickness="0"
                                            CornerRadius="8"
                                            Padding="10,12,12,12"
                                            Tag="{x:Bind}"
                                            Tapped="OnParagraphRowTapped">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="136" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 左列：段落序号与语义竖条 -->
                                                <Grid Grid.Column="0" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="2.5" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{x:Bind IndexDisplay, Mode=OneWay}"
                                                        FontSize="11.5"
                                                        FontWeight="{x:Bind BodyFontWeight, Mode=OneWay}"
                                                        Typography.NumeralAlignment="Tabular"
                                                        Foreground="{ThemeResource MutedTextBrush}"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,4,0,0" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Background="{x:Bind GutterStripBrush, Mode=OneWay}"
                                                        CornerRadius="1.5"
                                                        Margin="0,4,0,4" />
                                                </Grid>

                                                <!-- 中列：段落正文、原地编辑框及聚焦态上下文按钮条 -->
                                                <StackPanel Grid.Column="1" Spacing="8">
                                                    <TextBlock
                                                        Visibility="{x:Bind ReadingVisibility, Mode=OneWay}"
                                                        Text="{x:Bind Text, Mode=OneWay}"
                                                        FontSize="15"
                                                        FontWeight="{x:Bind BodyFontWeight, Mode=OneWay}"
                                                        LineHeight="27"
                                                        Foreground="{ThemeResource InkPrimaryBrush}"
                                                        TextWrapping="WrapWholeWords"
                                                        IsTextSelectionEnabled="True"
                                                        Tag="{x:Bind}"
                                                        DoubleTapped="OnParagraphDoubleTapped" />

                                                    <!-- 原地编辑输入框与确认动作 -->
                                                    <StackPanel Visibility="{x:Bind EditingVisibility, Mode=OneWay}" Spacing="8">
                                                        <TextBox
                                                            Text="{x:Bind EditDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            AcceptsReturn="False"
                                                            TextWrapping="Wrap"
                                                            FontSize="15"
                                                            FontWeight="{x:Bind BodyFontWeight, Mode=OneWay}"
                                                            Padding="12,10"
                                                            CornerRadius="8" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Button
                                                                Content="{x:Bind SaveAndRecheckLabel, Mode=OneWay}"
                                                                Style="{StaticResource MinimalPrimaryButtonStyle}"
                                                                Padding="11,5"
                                                                FontSize="12"
                                                                Tag="{x:Bind}"
                                                                Click="OnSaveAndRecheckParagraphClick" />
                                                            <Button
                                                                Content="{x:Bind SaveActionLabel, Mode=OneWay}"
                                                                Style="{StaticResource RowActionButtonStyle}"
                                                                Tag="{x:Bind}"
                                                                Click="OnSaveEditParagraphClick" />
                                                            <Button
                                                                Content="{x:Bind CancelActionLabel, Mode=OneWay}"
                                                                Style="{StaticResource RowActionButtonStyle}"
                                                                Tag="{x:Bind}"
                                                                Click="OnCancelEditParagraphClick" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- 聚焦后展开的行内快捷按钮 -->
                                                    <StackPanel
                                                        Visibility="{x:Bind ActionBarVisibility, Mode=OneWay}"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                        <Button Style="{StaticResource RowActionButtonStyle}" Tag="{x:Bind}" Click="OnEditParagraphClick">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE70F;" FontSize="11" VerticalAlignment="Center" Margin="0,1,0,0" />
                                                                <TextBlock Text="{x:Bind EditActionLabel, Mode=OneWay}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource RowActionButtonStyle}" Tag="{x:Bind}" Click="OnRecheckSingleParagraphClick">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE72C;" FontSize="11" VerticalAlignment="Center" Margin="0,1,0,0" />
                                                                <TextBlock Text="{x:Bind RecheckActionLabel, Mode=OneWay}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource RowActionButtonStyle}" Tag="{x:Bind}" Click="OnCopySingleParagraphClick">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="11" VerticalAlignment="Center" Margin="0,1,0,0" />
                                                                <TextBlock Text="{x:Bind CopyActionLabel, Mode=OneWay}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 右列：分类标签、等宽百分比、置信条及超长段三色聚合条 -->
                                                <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Top" Margin="0,4,0,0">
                                                    <StackPanel Visibility="{x:Bind AuditedMarginVisibility, Mode=OneWay}" Spacing="5">
                                                        <Grid>
                                                            <TextBlock
                                                                Text="{x:Bind LabelDisplay, Mode=OneWay}"
                                                                FontSize="12"
                                                                FontWeight="{x:Bind MediumFontWeight, Mode=OneWay}"
                                                                Foreground="{x:Bind LabelBadgeForeground, Mode=OneWay}"
                                                                VerticalAlignment="Center" />
                                                            <TextBlock
                                                                Text="{x:Bind ConfidencePercentText, Mode=OneWay}"
                                                                FontSize="12.5"
                                                                FontWeight="{x:Bind MediumFontWeight, Mode=OneWay}"
                                                                Typography.NumeralAlignment="Tabular"
                                                                Foreground="{x:Bind LabelBadgeForeground, Mode=OneWay}"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center" />
                                                        </Grid>

                                                        <Border Height="3" CornerRadius="1.5" Background="{ThemeResource TrackBgBrush}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{x:Bind ConfidenceFillWidth, Mode=OneWay}" />
                                                                    <ColumnDefinition Width="{x:Bind ConfidenceRestWidth, Mode=OneWay}" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{x:Bind LabelBadgeForeground, Mode=OneWay}" CornerRadius="1.5" />
                                                            </Grid>
                                                        </Border>

                                                        <!-- 超长段多子片段三色比例条 -->
                                                        <StackPanel Visibility="{x:Bind MultiSegmentVisibility, Mode=OneWay}" Spacing="3" Margin="0,1,0,0">
                                                            <Border Height="3" CornerRadius="1.5" Background="{ThemeResource TrackBgBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{x:Bind HumanSegmentWidth, Mode=OneWay}" />
                                                                        <ColumnDefinition Width="{x:Bind SuspectedSegmentWidth, Mode=OneWay}" />
                                                                        <ColumnDefinition Width="{x:Bind AiSegmentWidth, Mode=OneWay}" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="{ThemeResource HumanAccentBrush}" />
                                                                    <Border Grid.Column="1" Background="{ThemeResource SuspectedAccentBrush}" />
                                                                    <Border Grid.Column="2" Background="{ThemeResource AiAccentBrush}" />
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock
                                                                Text="{x:Bind MultiSegmentSummaryText, Mode=OneWay}"
                                                                FontSize="10.5"
                                                                Typography.NumeralAlignment="Tabular"
                                                                Foreground="{ThemeResource MutedTextBrush}"
                                                                HorizontalAlignment="Right" />
                                                        </StackPanel>

                                                        <TextBlock
                                                            Visibility="{x:Bind ModifiedPillVisibility, Mode=OneWay}"
                                                            Text="{x:Bind ModifiedLabelText, Mode=OneWay}"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource ModifiedAccentBrush}"
                                                            HorizontalAlignment="Right" />

                                                        <TextBlock
                                                            Visibility="{x:Bind DeltaVisibility, Mode=OneWay}"
                                                            Text="{x:Bind DeltaText, Mode=OneWay}"
                                                            FontSize="10.5"
                                                            Typography.NumeralAlignment="Tabular"
                                                            Foreground="{x:Bind DeltaBrush, Mode=OneWay}"
                                                            HorizontalAlignment="Right" />
                                                    </StackPanel>

                                                    <ProgressRing
                                                        Visibility="{x:Bind CheckingMarginVisibility, Mode=OneWay}"
                                                        Width="14"
                                                        Height="14"
                                                        IsActive="True"
                                                        HorizontalAlignment="Right" />

                                                    <TextBlock
                                                        Visibility="{x:Bind SkippedMarginVisibility, Mode=OneWay}"
                                                        Text="{x:Bind SkippedLabelText, Mode=OneWay}"
                                                        FontSize="11.5"
                                                        Foreground="{ThemeResource MutedTextBrush}"
                                                        HorizontalAlignment="Right" />

                                                    <TextBlock
                                                        Visibility="{x:Bind PendingMarginVisibility, Mode=OneWay}"
                                                        Text="—"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource MutedTextBrush}"
                                                        HorizontalAlignment="Right" />

                                                    <TextBlock
                                                        Visibility="{x:Bind ErrorMarginVisibility, Mode=OneWay}"
                                                        Text="{x:Bind ErrorDisplay, Mode=OneWay}"
                                                        FontSize="11.5"
                                                        Foreground="{ThemeResource AiAccentBrush}"
                                                        TextWrapping="Wrap"
                                                        HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>

                    <!-- 视图 C：整章纯文本编辑面板（应用后保留未改段落的检测分数） -->
                    <Grid
                        x:Name="BulkEditorContainer"
                        Padding="20"
                        RowSpacing="12"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox
                            x:Name="BulkRawTextBox"
                            Grid.Row="0"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FontSize="15"
                            FontWeight="{x:Bind TypeScale.BodyWeight, Mode=OneWay}"
                            Padding="16,14"
                            CornerRadius="10"
                            Background="{ThemeResource Surface2Brush}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="{x:Bind Strings.ActionCancel}" Style="{StaticResource GhostSurfaceButtonStyle}" Click="OnCancelBulkEditClick" />
                            <Button Content="{x:Bind Strings.ActionApply}" Style="{StaticResource MinimalPrimaryButtonStyle}" Click="OnApplyBulkEditClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右侧边栏：全文检测统计 + 段落热力分布与快速跳转 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">

                    <!-- 区块 1：全文检测总览与合并复核开关（点击三项占比即可筛选左侧段落） -->
                    <Border Style="{StaticResource Surface1PanelStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock
                                    Text="{x:Bind Strings.LabelFullTextAudit}"
                                    FontSize="13.5"
                                    FontWeight="{x:Bind TypeScale.StrongWeight, Mode=OneWay}"
                                    Foreground="{ThemeResource InkPrimaryBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Strings.LabelMergeCheck}" FontSize="11.5" FontWeight="{x:Bind TypeScale.BodyWeight, Mode=OneWay}" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <ToggleSwitch
                                        x:Name="FullMergeToggleSwitch"
                                        IsOn="True"
                                        OnContent=""
                                        OffContent=""
                                        MinWidth="0"
                                        Toggled="OnFullMergeToggled" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Visibility="{x:Bind Summary.StaleVisibility, Mode=OneWay}"
                                Text="{x:Bind Strings.LabelStaleNotice}"
                                FontSize="11.5"
                                Foreground="{ThemeResource SuspectedAccentBrush}" />

                            <!-- 全文三色堆叠比例条 -->
                            <Border Height="6" CornerRadius="3" Background="{ThemeResource TrackBgBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind Summary.HumanBarWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Summary.SuspectedBarWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Summary.AiBarWidth, Mode=OneWay}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource HumanAccentBrush}" />
                                    <Border Grid.Column="1" Background="{ThemeResource SuspectedAccentBrush}" />
                                    <Border Grid.Column="2" Background="{ThemeResource AiAccentBrush}" />
                                </Grid>
                            </Border>

                            <!-- 三大占比指标块（兼作数据筛选触发器） -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource KpiTileButtonStyle}" Click="OnToggleHumanFilterClick">
                                    <Border x:Name="HumanKpiBorder" Background="{ThemeResource Surface2Brush}" CornerRadius="8" Padding="10,9">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Strings.LabelHuman}" FontSize="11" FontWeight="{x:Bind TypeScale.BodyWeight, Mode=OneWay}" Foreground="{ThemeResource MutedTextBrush}" />
                                            <TextBlock
                                                Text="{x:Bind Summary.HumanPercentText, Mode=OneWay}"
                                                FontSize="16.5"
                                                FontWeight="{x:Bind TypeScale.StrongWeight, Mode=OneWay}"
                                                Typography.NumeralAlignment="Tabular"
                                                Foreground="{ThemeResource HumanAccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="1" Style="{StaticResource KpiTileButtonStyle}" Click="OnToggleSuspectedFilterClick">
                                    <Border x:Name="SuspectedKpiBorder" Background="{ThemeResource Surface2Brush}" CornerRadius="8" Padding="10,9">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Strings.LabelSuspected}" FontSize="11" FontWeight="{x:Bind TypeScale.BodyWeight, Mode=OneWay}" Foreground="{ThemeResource MutedTextBrush}" />
                                            <TextBlock
                                                Text="{x:Bind Summary.SuspectedPercentText, Mode=OneWay}"
                                                FontSize="16.5"
                                                FontWeight="{x:Bind TypeScale.StrongWeight, Mode=OneWay}"
                                                Typography.NumeralAlignment="Tabular"
                                                Foreground="{ThemeResource SuspectedAccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="2" Style="{StaticResource KpiTileButtonStyle}" Click="OnToggleAiFilterClick">
                                    <Border x:Name="AiKpiBorder" Background="{ThemeResource Surface2Brush}" CornerRadius="8" Padding="10,9">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Strings.LabelAi}" FontSize="11" FontWeight="{x:Bind TypeScale.BodyWeight, Mode=OneWay}" Foreground="{ThemeResource MutedTextBrush}" />
                                            <TextBlock
                                                Text="{x:Bind Summary.AiPercentText, Mode=OneWay}"
                                                FontSize="16.5"
                                                FontWeight="{x:Bind TypeScale.StrongWeight, Mode=OneWay}"
                                                Typography.NumeralAlignment="Tabular"
                                                Foreground="{ThemeResource AiAccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </Grid>

                            <!-- 辅助置信度与风险占比 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{ThemeResource Surface2Brush}" CornerRadius="8" Padding="10,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Strings.LabelConfidence}" FontSize="11" FontWeight="{x:Bind TypeScale.BodyWeight, Mode=OneWay}" Foreground="{ThemeResource MutedTextBrush}" />
                                        <TextBlock
                                            Text="{x:Bind Summary.SoftmaxConfidenceText, Mode=OneWay}"
                                            FontSize="14"
                                            FontWeight="{x:Bind TypeScale.MediumWeight, Mode=OneWay}"
                                            Typography.NumeralAlignment="Tabular"
                                            Foreground="{ThemeResource InkPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource Surface2Brush}" CornerRadius="8" Padding="10,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Strings.LabelRiskRatio}" FontSize="11" FontWeight="{x:Bind TypeScale.BodyWeight, Mode=OneWay}" Foreground="{ThemeResource MutedTextBrush}" />
                                        <TextBlock
                                            Text="{x:Bind Summary.RatioConfidenceText, Mode=OneWay}"
                                            FontSize="14"
                                            FontWeight="{x:Bind TypeScale.MediumWeight, Mode=OneWay}"
                                            Typography.NumeralAlignment="Tabular"
                                            Foreground="{ThemeResource InkPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 逐段对照参考与改稿变化趋势 -->
                            <Grid Visibility="{x:Bind Summary.SegmentComparisonVisibility, Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind Summary.SegmentComparisonText, Mode=OneWay}"
                                    FontSize="11"
                                    Typography.NumeralAlignment="Tabular"
                                    Foreground="{ThemeResource MutedTextBrush}" />
                                <TextBlock
                                    Visibility="{x:Bind Summary.AiDeltaVisibility, Mode=OneWay}"
                                    Text="{x:Bind Summary.AiDeltaText, Mode=OneWay}"
                                    FontSize="11"
                                    Typography.NumeralAlignment="Tabular"
                                    Foreground="{x:Bind Summary.AiDeltaBrush, Mode=OneWay}"
                                    HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 区块 2：章节段落热力图与风险段跳转导航（Alt+↑ / Alt+↓） -->
                    <Border x:Name="DistributionCard" Style="{StaticResource Surface1PanelStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock
                                    Text="{x:Bind Strings.LabelDistribution}"
                                    FontSize="13.5"
                                    FontWeight="{x:Bind TypeScale.StrongWeight, Mode=OneWay}"
                                    Foreground="{ThemeResource InkPrimaryBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                    <Button x:Name="PrevRiskButton" Style="{StaticResource RowActionButtonStyle}" Click="OnPreviousRiskClick">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="Up" Modifiers="Menu" />
                                        </Button.KeyboardAccelerators>
                                        <FontIcon Glyph="&#xE74A;" FontSize="11" VerticalAlignment="Center" Margin="0,1,0,0" />
                                    </Button>
                                    <Button x:Name="NextRiskButton" Style="{StaticResource RowActionButtonStyle}" Click="OnNextRiskClick">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="Down" Modifiers="Menu" />
                                        </Button.KeyboardAccelerators>
                                        <FontIcon Glyph="&#xE74B;" FontSize="11" VerticalAlignment="Center" Margin="0,1,0,0" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 可点击段落风险色块矩阵 -->
                            <ItemsRepeater x:Name="HeatmapRepeater">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        MinItemWidth="14"
                                        MinItemHeight="14"
                                        MinRowSpacing="4"
                                        MinColumnSpacing="4"
                                        ItemsStretch="None" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ParagraphItem">
                                        <Button
                                            Width="14"
                                            Height="14"
                                            Padding="0"
                                            MinWidth="0"
                                            MinHeight="0"
                                            CornerRadius="3"
                                            BorderThickness="0"
                                            Background="{x:Bind HeatmapTileBrush, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            Click="OnHeatmapTileClick"
                                            ToolTipService.ToolTip="{x:Bind TooltipSummary, Mode=OneWay}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- 跳过与已改筛选入口（有对应段落时才出现） -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="SkippedFilterLink" Style="{StaticResource RowActionButtonStyle}" Padding="6,2" Visibility="Collapsed" Click="OnToggleSkippedFilterClick" />
                                <Button x:Name="ModifiedFilterLink" Style="{StaticResource RowActionButtonStyle}" Padding="6,2" Visibility="Collapsed" Click="OnToggleModifiedFilterClick" />
                            </StackPanel>

                            <!-- 高风险段落快速跳转列表 -->
                            <ItemsRepeater x:Name="RiskListRepeater" Visibility="Collapsed">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="3" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ParagraphItem">
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="8,6"
                                            CornerRadius="6"
                                            Style="{StaticResource GhostSurfaceButtonStyle}"
                                            Tag="{x:Bind}"
                                            Click="OnHeatmapTileClick">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind IndexDisplay, Mode=OneWay}"
                                                    FontSize="11.5"
                                                    Typography.NumeralAlignment="Tabular"
                                                    Foreground="{x:Bind LabelBadgeForeground, Mode=OneWay}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind PreviewSnippet, Mode=OneWay}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource InkPrimaryBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{x:Bind ConfidencePercentText, Mode=OneWay}"
                                                    FontSize="11.5"
                                                    Typography.NumeralAlignment="Tabular"
                                                    Foreground="{x:Bind LabelBadgeForeground, Mode=OneWay}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- 本次检测实际扣减的 Makers Token 计数（仅在有消耗时显示） -->
                    <TextBlock
                        Visibility="{x:Bind Summary.TokensVisibility, Mode=OneWay}"
                        Text="{x:Bind Summary.TokensDisplay, Mode=OneWay}"
                        FontSize="11.5"
                        Typography.NumeralAlignment="Tabular"
                        Foreground="{ThemeResource MutedTextBrush}"
                        Margin="6,0,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
