<?xml version="1.0" encoding="utf-8"?>
<!-- 应用设置弹窗：管理 API Key 鉴权与连通性测试、短段跳过策略、全文复核开关及外观主题 -->
<ContentDialog
    x:Class="InkAudit.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{x:Bind Strings.ActionSettings}"
    PrimaryButtonText="{x:Bind Strings.ActionSave}"
    CloseButtonText="{x:Bind Strings.ActionCancel}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="14" Width="420" Padding="0,4,0,0">

        <!-- 区块 1：API Key 输入与即时连通性测试 -->
        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind Strings.SettingsApiKey}" FontSize="12.5" Foreground="{ThemeResource MutedTextBrush}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox
                    x:Name="ApiKeyBox"
                    Grid.Column="0"
                    PasswordRevealMode="Peek" />
                <Button
                    x:Name="TestConnectionButton"
                    Grid.Column="1"
                    Content="{x:Bind Strings.ActionTest}"
                    Click="OnTestConnectionClick" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="TestProgressRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="TestStatusText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>

        <!-- 区块 2：朱雀分类接口网关地址 -->
        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind Strings.SettingsEndpoint}" FontSize="12.5" Foreground="{ThemeResource MutedTextBrush}" />
            <TextBox x:Name="EndpointBox" />
        </StackPanel>

        <!-- 区块 3：短段跳过策略与最小字数阈值 -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="108" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Strings.SettingsSkipShort}" FontSize="13" VerticalAlignment="Center" />
            <ToggleSwitch
                x:Name="ShortSkipToggle"
                Grid.Column="1"
                OnContent=""
                OffContent=""
                MinWidth="0"
                Toggled="OnShortSkipToggled" />
            <NumberBox
                x:Name="ShortThresholdBox"
                Grid.Column="2"
                Minimum="0"
                Maximum="200"
                SmallChange="5"
                SpinButtonPlacementMode="Compact" />
        </Grid>

        <!-- 区块 4：全文合并复核开关（默认开启） -->
        <Grid>
            <TextBlock Text="{x:Bind Strings.SettingsFullMerge}" FontSize="13" VerticalAlignment="Center" />
            <ToggleSwitch
                x:Name="FullMergeToggle"
                HorizontalAlignment="Right"
                OnContent=""
                OffContent=""
                MinWidth="0" />
        </Grid>

        <!-- 区块 5：高风险段落背景淡着色开关 -->
        <Grid>
            <TextBlock Text="{x:Bind Strings.SettingsHeatmapTint}" FontSize="13" VerticalAlignment="Center" />
            <ToggleSwitch
                x:Name="HeatmapTintSettingToggle"
                HorizontalAlignment="Right"
                OnContent=""
                OffContent=""
                MinWidth="0" />
        </Grid>

        <!-- 区块 6：界面主题模式选择 -->
        <Grid>
            <TextBlock Text="{x:Bind Strings.SettingsTheme}" FontSize="13" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemeComboBox" Width="140" HorizontalAlignment="Right">
                <ComboBoxItem Content="{x:Bind Strings.ThemeDefault}" Tag="Default" />
                <ComboBoxItem Content="{x:Bind Strings.ThemeLight}" Tag="Light" />
                <ComboBoxItem Content="{x:Bind Strings.ThemeDark}" Tag="Dark" />
            </ComboBox>
        </Grid>

    </StackPanel>
</ContentDialog>
